# ---- CareerVerse environment variables ----
# All optional in local/beta mode; the app runs fully without any of them.

# ---- AI provider ----
# Provider selection (src/lib/ai/select.ts), in order:
#   AI_PROVIDER=mock  -> mock, explicitly (tests / offline development)
#   OPENAI_API_KEY    -> OpenAI          (preferred when both keys are set)
#   ANTHROPIC_API_KEY -> Anthropic
#   neither           -> mock, and every response is labeled provider:"mock"
# /api/health reports only "openai-configured" / "anthropic-configured" /
# "not-configured" — never a key value. Keys are server-only and never sent to
# the browser, logged, or included in an API response or an error message.
OPENAI_API_KEY=
# Optional. Pins the OpenAI model; defaults to gpt-4.1-mini. The scholarship
# task is claim SELECTION over a supplied list, not open-ended generation, so a
# small model is appropriate.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Set to "mock" to force the rule-based provider even when a key is present.
AI_PROVIDER=

# Optional bearer token that authorizes the protected AI smoke test
# (POST /api/ai/smoke-test). Must be a strong secret (>=16 chars, mixed classes).
# If unset, ADMIN_ACCESS_CODE authorizes the smoke test instead; if neither is
# set the endpoint stays closed (503).
AI_SMOKE_TEST_TOKEN=

# Admin area access code (server-checked). Default in dev: "careerverse-admin".
ADMIN_ACCESS_CODE=careerverse-admin

# Beta access code required to create an account. Default: "KANTO-BETA".
NEXT_PUBLIC_BETA_CODE=KANTO-BETA

# ---- Private-beta invite gate ----
# Comma-separated SHA-256 hashes of valid invite codes, each optionally with
# expiry and max uses:  <sha256hex>[:<expiresISO>[:<maxUses>]]
# Generate codes+hashes in Admin → Dashboard → Invite codes.
# If unset, the hash of NEXT_PUBLIC_BETA_CODE is accepted (development default).
# Removing an entry revokes that code immediately.
INVITE_CODE_HASHES=

# ---- Support delivery ----
# Webhook that receives support tickets as JSON (e.g. Slack/Discord webhook or
# a form-to-email relay). Without it, tickets get a reference number and the
# UI says clearly that no team inbox is configured yet.
SUPPORT_WEBHOOK_URL=
# Public support email shown in the UI. If unset, NO email is displayed
# (never a fake address).
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- Production persistence (Supabase) — not required for local beta ----
# When set, apply supabase/migrations and switch the storage adapter.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
