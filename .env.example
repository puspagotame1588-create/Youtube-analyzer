# ---- CareerVerse environment variables ----
# All optional in local/beta mode; the app runs fully without any of them.

# Anthropic API key for live AI explanations/translation. Without it, the
# labeled Mock AI provider is used (never presented as live AI).
ANTHROPIC_API_KEY=

# Admin area access code (server-checked). Default in dev: "careerverse-admin".
ADMIN_ACCESS_CODE=careerverse-admin

# Beta access code required to create an account. Default: "KANTO-BETA".
NEXT_PUBLIC_BETA_CODE=KANTO-BETA

# ---- Production persistence (Supabase) — not required for local beta ----
# When set, apply supabase/migrations and switch the storage adapter.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
