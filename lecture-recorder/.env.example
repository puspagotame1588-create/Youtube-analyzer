# ===== 必須 =====
# OpenAI の API キー。文字起こし・翻訳・要約に使います。
OPENAI_API_KEY=

# ===== 任意（変更しなくても動きます）=====
# 録音・書き起こし・ノートの保存先。既定は C:\Users\<ユーザー名>\LectureRecorder
# LECTURE_DATA_DIR=D:\Lectures

# ライブ字幕用の文字起こしモデル（速さ重視）
# OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# 録音後の精密文字起こしモデル（精度重視・専門用語のヒントに対応）
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# 要約・ノート・質問応答のモデル
# OPENAI_LLM_MODEL=gpt-5.6-terra
# ライブ翻訳のモデル（安さ・速さ重視）
# OPENAI_FAST_LLM_MODEL=gpt-5.6-luna

# 字幕の更新間隔（秒）
# LIVE_CHUNK_SEC=10
# 精密文字起こしの区切り（秒）。API の上限があるため 1200 秒以下にしてください。
# PASS_CHUNK_SEC=600
# 音質（bps）。32000 が音声には十分です。
# AUDIO_BITRATE=32000
