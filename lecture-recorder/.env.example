# ===== 必須 =====
# OpenAI の API キー。文字起こしと要約に使います。
OPENAI_API_KEY=

# ===== 任意（変更しなくても動きます）=====
# 録音・書き起こし・ノートの保存先。既定は C:\Users\<ユーザー名>\LectureRecorder
# LECTURE_DATA_DIR=D:\Lectures

# ライブ字幕用の文字起こしモデル。日本語の精度が最優先なので、既定は
# gpt-transcribe です。速さを優先する場合のみ gpt-4o-mini-transcribe に
# 変更してください（漢字・専門用語の誤りが増えます）。
# OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-transcribe
# 録音後の精密文字起こしモデル（専門用語のヒントに対応）
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# 要約・ノート・質問応答のモデル
# OPENAI_LLM_MODEL=gpt-5.6-terra

# 字幕の更新間隔（秒）。短くすると文の途中で切れて精度が落ちます。
# LIVE_CHUNK_SEC=15
# 精密文字起こしの区切り（秒）。API の上限があるため 1200 秒以下にしてください。
# PASS_CHUNK_SEC=600
# 音質（bps）。広い教室では 64000 を推奨します。
# AUDIO_BITRATE=64000
