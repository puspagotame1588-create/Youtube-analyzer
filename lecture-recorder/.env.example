# Copy this file to .env.local and fill in your keys.
# Without keys the app runs in DEMO mode (fake transcript, no real API calls).

# Speech-to-text for the Japanese audio (OpenAI). Required for real transcription.
OPENAI_API_KEY=
# Optional. Default: gpt-4o-transcribe. Alternatives: gpt-4o-mini-transcribe (cheaper), whisper-1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Live translation + summary/main points (Anthropic). Required for real English output.
ANTHROPIC_API_KEY=
# Optional. Model used for the post-lecture summary and main points. Default: claude-opus-5
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5
# Optional. Model used for the live 10-second translations. Default: claude-opus-5
# Set to claude-haiku-4-5 if you want the live translation to be cheaper.
ANTHROPIC_TRANSLATE_MODEL=claude-opus-5
