# ---------------------------------------------------------------------------
# MiraiPath Japan — environment variables
#
# The project runs WITHOUT any of these set. When Supabase credentials are
# missing, the app automatically runs in "Demo mode": seeded fictional data,
# localStorage persistence, and a visible demo banner.
# ---------------------------------------------------------------------------

# Public URL of the deployment (used for metadata / Open Graph / sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (optional). Create a project at https://supabase.com, then run
# supabase/schema.sql in the SQL editor and copy the values from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
