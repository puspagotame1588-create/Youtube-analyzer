# ---------------------------------------------------------------------------
# MiraiPath Japan — environment variables
#
# The project runs WITHOUT any of these set. When Supabase credentials are
# missing, the app automatically runs in "Demo mode": seeded fictional data,
# localStorage persistence, and a visible demo banner.
# ---------------------------------------------------------------------------

# Public URL of the deployment (used for metadata / Open Graph / sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (optional). Create a project at https://supabase.com, then run
# supabase/schema.sql in the SQL editor and copy the values from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email notifications (optional). When set, every institution partner inquiry
# and student consultation request is emailed to you via Gmail SMTP by the
# /api/notify route. These are SERVER-ONLY secrets — never prefixed with
# NEXT_PUBLIC, so they are never exposed to the browser.
#
# Setup:
#   1. On the Gmail account, enable 2-Step Verification.
#   2. Create an App Password: Google Account -> Security -> App passwords.
#   3. Set GMAIL_USER to that address and GMAIL_APP_PASSWORD to the 16-char
#      app password (spaces optional). NOTIFY_TO defaults to GMAIL_USER.
# On Vercel, add these under Project Settings -> Environment Variables so the
# secret never lives in the repo.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_TO=
